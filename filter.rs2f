/*@ define:module:header
hidden: true
name: header
*/

/*
  Raxor's Loot Filter
  Later modules win (apply overwrites). rule is terminal.

  display → loot_order → hide → locations → kinds → value → clues → rares → alerts → final
*/

meta {
    name = "Raxor's Loot Filter";
    description = "OSRS ground loot. Categories, clues, value, then collection-log rares.";
}

/*@ define:module:tokens
hidden: true
name: tokens
*/

// Visual language. Style inputs below still expand to raw properties so
// Filterscape's editor works. These tokens are the source of truth for
// anything that is not a style input.

#define RAX_INK            "#ff000000"
#define RAX_INK_WHITE      "#FFFFFFFF"
#define RAX_INK_SOFT       "#47000000"
#define RAX_INK_HARD       "#87000000"

#define RAX_HEAT_1_FILL    "#9945dc32"
#define RAX_HEAT_2_FILL    "#9966b2ff"
#define RAX_HEAT_3_FILL    "#99f29b4b"
#define RAX_HEAT_4_FILL    "#99c30000"
#define RAX_ALCH_FILL      "#a1fadb3e"
#define RAX_CLUE_FILL      "#80908062"
#define RAX_CLUE_BEGINNER  "#FFCFC8C8"
#define RAX_CLUE_EASY      "#FF248F26"
#define RAX_CLUE_MEDIUM    "#FF6CBBBF"
#define RAX_CLUE_HARD      "#FFA343BD"
#define RAX_CLUE_ELITE     "#FFEED11D"
#define RAX_CLUE_MASTER    "#FFC33C30"
#define RAX_UNIQUE_ACCENT  "#ffff0084"
#define RAX_RDT_GOLD       "#FFdea71a"
#define RAX_STACK_LILAC    "#ffd7b3e8"
#define RAX_UNTRADE_ROSE   "#fff79e9e"

#define RAX_ICON_ITEM      CurrentItem()
#define RAX_ICON_OFF       Sprite(9000000, 0)
#define RAX_ICON_ALCH      File("alch.png")
#define RAX_ICON_FOOD      Sprite(3288, 0)

#define RAX_SOUND_HEAT_3   "tier3.wav"
#define RAX_SOUND_HEAT_4   "tier4.wav"
#define RAX_SOUND_UNIQUE   "uniques.wav"
#define RAX_SOUND_CLUE     "clues.wav"
#define RAX_SOUND_SILENCE  2411

#define RAX_FONT_SMALL     1
#define RAX_FONT_BOLD      3
#define RAX_ACCENT_SHADOW  1

/*@ define:module:display
---
name: Display
subtitle: What the floor shows
description: |
  Masters first. Later modules overwrite the look, not these switches.
*/

/*@ define:group
---
name: Show
icon:
  type: itemId
  itemId: 1755
expanded: false
*/


/*@ define:input:display
type: boolean
label: Despawn
group: Show
*/
#define RAX_SHOW_DESPAWN true

/*@ define:input:display
type: boolean
label: Prices
group: Show
*/
#define RAX_SHOW_TRADEABLE_VALUE true

/*@ define:input:display
type: boolean
label: Icons
group: Show
*/
#define RAX_SHOW_ICONS true

/*@ define:input:display
type: boolean
label: Beams
group: Show
*/
#define RAX_ALLOW_LOOTBEAMS true

/*@ define:input:display
type: boolean
label: Sounds
group: Show
*/
#define RAX_ALLOW_SOUNDS true

/*@ define:input:display
type: style
label: Default
exampleItem: Santa hat
exampleItemId: 1050
*/
#define RAX_IDENTITY_DEFAULT textColor = "#FFFFFFFF"; textAccentColor = "#ff000000"; textAccent = 1; showDespawn = true; menuSort = 0; icon = CurrentItem();

apply (true) {
    RAX_IDENTITY_DEFAULT
}

/*@ define:input:display
type: style
label: Stackable / noted
exampleItem: Magic shortbow (u)
exampleItemId: 73
*/
#define RAX_IDENTITY_STACK textColor = "#ffd7b3e8"; textAccentColor = "#ff000000"; menuTextColor = "#ffd7b3e8"; textAccent = 1; showDespawn = true; icon = CurrentItem();

apply (stackable:true || noted:true) {
    RAX_IDENTITY_STACK
}

/*@ define:input:display
type: style
label: Untradeable
exampleItem: Long bone
exampleItemId: 10976
*/
#define RAX_IDENTITY_UNTRADE textColor = "#fff79e9e"; textAccentColor = "#ff000000"; menuTextColor = "#fff79e9e"; showDespawn = true; icon = CurrentItem();

apply (tradeable:false && !name:FACT_GLOBAL_TRADEABLE_NON_TRADEABLE_ITEMS) {
    RAX_IDENTITY_UNTRADE
}

/*@ define:group
---
name: Prices
icon:
  type: itemId
  itemId: 995
expanded: false
*/


apply ((tradeable:true || name:FACT_GLOBAL_TRADEABLE_NON_TRADEABLE_ITEMS) && RAX_SHOW_TRADEABLE_VALUE) {
    showValue = true;
}

/*@ define:input:display
type: boolean
label: Show prices on untradeables
group: Prices
*/
#define RAX_SHOW_UNTRADEABLE_VALUE false

apply (tradeable:false && RAX_SHOW_UNTRADEABLE_VALUE) {
    showValue = true;
}

/*@ define:input:display
type: number
label: Hide prices below this gp
group: Prices
*/
#define RAX_PRICE_MIN_VALUE 20000

apply ((tradeable:true || name:FACT_GLOBAL_TRADEABLE_NON_TRADEABLE_ITEMS) && value:<RAX_PRICE_MIN_VALUE) {
    showValue = false;
}

/*@ define:group
---
name: Timers
icon:
  type: itemId
  itemId: 3853
expanded: false
*/


apply (RAX_SHOW_DESPAWN) {
    showDespawn = true;
}

apply (!RAX_SHOW_DESPAWN) {
    showDespawn = false;
}

/*@ define:input:display
type: number
label: Hide despawn timer below this gp
group: Timers
*/
#define RAX_DESPAWN_MIN_VALUE 0

apply ((tradeable:true || name:FACT_GLOBAL_TRADEABLE_NON_TRADEABLE_ITEMS) && value:<RAX_DESPAWN_MIN_VALUE) {
    showDespawn = false;
}

/*@ define:group
---
name: Icons
icon:
  type: itemId
  itemId: 1733
expanded: false
*/


apply (!RAX_SHOW_ICONS) {
    icon = Sprite(9000000, 0);
}

/*@ define:input:display
type: number
label: Hide icons below this gp
group: Icons
*/
#define RAX_ICON_MIN_VALUE 0

apply (RAX_SHOW_ICONS && (tradeable:true || name:FACT_GLOBAL_TRADEABLE_NON_TRADEABLE_ITEMS) && value:<RAX_ICON_MIN_VALUE) {
    icon = Sprite(9000000, 0);
}

/*@ define:input:display
type: stringlist
label: Always show an icon for these
group: Icons
*/
#define RAX_ICON_ALWAYS []

apply (RAX_SHOW_ICONS && name:RAX_ICON_ALWAYS) {
    icon = CurrentItem();
}

/*@ define:input:display
type: boolean
label: Same icon on every skilling/supply drop
group: Icons
*/
#define RAX_FORCE_CATEGORY_ICON true

/*@ define:input:display
type: style
label: That icon
group: Icons
exampleItem: Santa hat
exampleItemId: 1050
*/
#define RAX_CATEGORY_ICON_STYLE icon = CurrentItem();

/*@ define:group
---
name: Beams and sounds
icon:
  type: itemId
  itemId: 560
description: |
  Masters. Value and Rares can still turn beams/sounds back on for those drops
  unless you also disable them there.
expanded: false
*/


/*@ define:input:display
type: boolean
label: Allow notifications
group: Beams and sounds
*/
#define RAX_ALLOW_NOTIFY true

apply (!RAX_ALLOW_NOTIFY) {
    notify = false;
}

/*@ define:module:loot_order
---
name: Loot order
subtitle: Take-menu order
description: |
  What you pick up first. Turn OFF "Price Sort" in Custom Menu Swaps → Ground Item Sort.

  The ladder itself is generated in the hidden final pass.
*/

/*@ define:input:loot_order
type: boolean
label: Sort by GE value
*/
#define RAX_SORT_BY_VALUE true

/*@ define:input:loot_order
type: boolean
label: Stackable / noted first
*/
#define RAX_SORT_STACKABLES_FIRST true

/*@ define:input:loot_order
type: boolean
label: Untradeables first
*/
#define RAX_SORT_UNTRADEABLE_FIRST true

/*@ define:input:loot_order
type: stringlist
label: Always take these first
*/
#define RAX_SORT_PIN ["xeric's aid*","Revitalisation*","Prayer enhance*","twisted*"]

