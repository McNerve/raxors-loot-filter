    hidden = true;
}

apply (name:FACT_SHADES_REMAINS_LIST && value:<RAX_REMAINS_MINIMUM_VALUE) {
    hidden = true;
}

apply (name:FACT_ENSOULED_HEAD_LIST && value:<RAX_REMAINS_MINIMUM_VALUE) {
    hidden = true;
}

