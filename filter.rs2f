    hidden = true;
}
apply ((name:FACT_IRON_ONE_HANDED_MELEE_WEAPONS || name:FACT_IRON_TWO_HANDED_MELEE_WEAPONS || name:FACT_IRON_RANGED_WEAPONS || name:FACT_IRON_AMMO || name:FACT_IRON_ARMOUR || name:FACT_IRON_OTHER) && name:RAX_METAL_EQUIPMENT_TIERS_HIDE && !name:FACT_DEFENDERS_LIST) {
    hidden = true;
}
apply ((name:FACT_STEEL_ONE_HANDED_MELEE_WEAPONS || name:FACT_STEEL_TWO_HANDED_MELEE_WEAPONS || name:FACT_STEEL_RANGED_WEAPONS || name:FACT_STEEL_AMMO || name:FACT_STEEL_ARMOUR || name:FACT_STEEL_OTHER) && name:RAX_METAL_EQUIPMENT_TIERS_HIDE && !name:FACT_DEFENDERS_LIST) {
    hidden = true;
}
apply ((name:FACT_BLACK_ONE_HANDED_MELEE_WEAPONS || name:FACT_BLACK_TWO_HANDED_MELEE_WEAPONS || name:FACT_BLACK_RANGED_WEAPONS || name:FACT_BLACK_AMMO || name:FACT_BLACK_ARMOUR || name:FACT_BLACK_OTHER) && name:RAX_METAL_EQUIPMENT_TIERS_HIDE && !name:FACT_DEFENDERS_LIST) {
    hidden = true;
}
apply ((name:FACT_MITHRIL_ONE_HANDED_MELEE_WEAPONS || name:FACT_MITHRIL_TWO_HANDED_MELEE_WEAPONS || name:FACT_MITHRIL_RANGED_WEAPONS || name:FACT_MITHRIL_AMMO || name:FACT_MITHRIL_ARMOUR || name:FACT_MITHRIL_OTHER) && name:RAX_METAL_EQUIPMENT_TIERS_HIDE && !name:FACT_DEFENDERS_LIST) {
    hidden = true;
}
apply ((name:FACT_ADAMANT_ONE_HANDED_MELEE_WEAPONS || name:FACT_ADAMANT_TWO_HANDED_MELEE_WEAPONS || name:FACT_ADAMANT_RANGED_WEAPONS || name:FACT_ADAMANT_AMMO || name:FACT_ADAMANT_ARMOUR || name:FACT_ADAMANT_OTHER) && name:RAX_METAL_EQUIPMENT_TIERS_HIDE && !name:FACT_DEFENDERS_LIST) {
