/*@ define:input:hide
type: stringlist
label: Items to hide
group: Individual Items
*/
#define RAX_GLOBAL_HIDE ["broken arrow","old boot","crushed gem","burnt*","half pie*","*talisman","rotten*","waterskin(1)","waterskin(2)","waterskin(3)","flyer","*bead","potion","vampyre dust","pirate boots","oyster pearls","ugthanki kebab","unholy symbol"]

apply (name:RAX_GLOBAL_HIDE) {
    hidden = true;
}

/*@ define:input:hide
type: stringlist
label: Items to show
group: Individual Items
*/
#define RAX_GLOBAL_SHOW ["Loop half of key","Tooth half of key","Rune spear","Shield left half","Dragon spear"]

apply (name:RAX_GLOBAL_SHOW) {
    hidden = false;
}


/*@ define:input:hide
type: number
label: Hide items below this value
group: Value-Based
*/
#define RAX_GLOBAL_MINIMUM_VALUE 0

apply ((tradeable:true || name:FACT_GLOBAL_TRADEABLE_NON_TRADEABLE_ITEMS) && value:<RAX_GLOBAL_MINIMUM_VALUE) {
    hidden = true;
}

/*@ define:input:hide
type: number
label: Hide stackable items below this value
group: Value-Based
*/
#define RAX_GLOBAL_STACKABLE_MINIMUM_VALUE 250

apply ((tradeable:true || name:FACT_GLOBAL_TRADEABLE_NON_TRADEABLE_ITEMS) && (stackable:true || noted:true) && value:<RAX_GLOBAL_STACKABLE_MINIMUM_VALUE) {
    hidden = true;
}

/*@ define:input:hide
type: number
label: Hide non-stackable items below this value
group: Value-Based
*/
#define RAX_GLOBAL_NON_STACKABLE_MINIMUM_VALUE 1000

apply ((tradeable:true || name:FACT_GLOBAL_TRADEABLE_NON_TRADEABLE_ITEMS) && stackable:false && noted:false && value:<RAX_GLOBAL_NON_STACKABLE_MINIMUM_VALUE) {
    hidden = true;
}


/*@ define:input:hide
type: boolean
label: Hide others' drops
group: Ownership
*/
#define RAX_GLOBAL_HIDE_OTHER_PLAYERS_ITEMS false

/*@ define:input:hide
type: boolean
label: Hide world spawns
group: Ownership
*/
#define RAX_GLOBAL_HIDE_SPAWN_ITEMS true

/*@ define:input:hide
type: stringlist
label: Exceptions to ownership
group: Ownership
*/
#define RAX_OWNERSHIP_FILTERING_EXCEPTIONS ["Water container","Dawnbringer","Elder*","Twisted*","Kodai*","Revitalisation*","Prayer enhance*","Xeric's aid*","Antipoison*","Overload*","Golpar seed","Buchu seed","Noxifer seed","Endarkened juice","Stinkhorn mushroom","Cicely","Mallignum root plank"]

rule (RAX_GLOBAL_HIDE_SPAWN_ITEMS && ownership:OWNERSHIP_NONE && !name:RAX_OWNERSHIP_FILTERING_EXCEPTIONS) {
    hidden = true;
    sound = 2411; // sound name: silence
    notify = false;
}

rule (RAX_GLOBAL_HIDE_OTHER_PLAYERS_ITEMS && ownership:OWNERSHIP_OTHER && !name:RAX_OWNERSHIP_FILTERING_EXCEPTIONS) {
    hidden = true;
    sound = 2411; // sound name: silence
    notify = false;
}


