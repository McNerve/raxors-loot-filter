*/
#define RAX_MUTE_BH false

apply (RAX_MUTE_BH && area:FACT_BOUNTY_HUNTER_AREA) {
    sound = 2411;
    notify = false;
}

/*@ define:input:alerts
type: boolean
label: Mute other players' drops
group: Mute
*/
#define RAX_MUTE_OTHERS false

apply (RAX_MUTE_OTHERS && ownership:OWNERSHIP_OTHER) {
    sound = 2411;
    notify = false;
}

/*@ define:input:alerts
type: boolean
label: Mute world spawns
group: Mute
*/
#define RAX_MUTE_SPAWNS false

apply (RAX_MUTE_SPAWNS && ownership:OWNERSHIP_NONE) {
    sound = 2411;
    notify = false;
}

/*@ define:module:final
hidden: true
name: final
*/

// Last hide/show pass + generated sort ladder (replaces ~800 pasted applies).

apply (name:RAX_GLOBAL_HIDE) {
    hidden = true;
}
apply (name:RAX_GLOBAL_SHOW) {
    hidden = false;
}

#define RAX_SORT_BAND(_cond, _lo, _hi, _pri) apply (_cond && value:>=_lo && value:<_hi) { menuSort = _pri; }
#define RAX_SORT_CEIL(_cond, _lo, _pri) apply (_cond && value:>=_lo) { menuSort = _pri; }

#define RAX_SORT_VALUE (RAX_SORT_BY_VALUE || RAX_SORT_STACKABLES_FIRST)
#define RAX_SORT_STACK (RAX_SORT_STACKABLES_FIRST && (stackable:true || noted:true))
#define RAX_SORT_UNTRADE (RAX_SORT_UNTRADEABLE_FIRST && tradeable:false)

