/*@ define:input:food
type: style
label: All Food Items Style
group: Food
exampleItem: Anglerfish
exampleItemId: 13441
*/
#define RAX_CATEGORY_FOOD_CUSTOMSTYLE icon = Sprite(3288, 0);

apply(name:FACT_FISH_FOODS_LIST || name:FACT_POTATOES_FOODS_LIST || name:FACT_HUNTER_FOODS_LIST || name:FACT_PIE_FOODS_LIST || name:FACT_PIZZA_FOODS_LIST || name:FACT_CAKE_FOODS_LIST) {
    RAX_CATEGORY_FOOD_CUSTOMSTYLE
}
