expanded: false
*/
/*@ define:input:runes
type: style
label: All Runes Items Style
group: Runes
exampleItem: Wrath rune
exampleItemId: 21880
*/
#define RAX_CATEGORY_RUNES_CUSTOMSTYLE icon = Sprite(3192, 0);

apply (name:FACT_RUNES_LIST) {
    RAX_CATEGORY_RUNES_CUSTOMSTYLE
}
