/*@ define:input:floor
type: number
label: Minimum value to display remains at
group: Remains
*/
#define RAX_REMAINS_MINIMUM_VALUE 0

apply (name:FACT_BONES_LIST && value:<RAX_REMAINS_MINIMUM_VALUE) {
    hidden = true;
}

apply (name:FACT_ASHES_LIST && value:<RAX_REMAINS_MINIMUM_VALUE) {
    hidden = true;
}

apply (name:FACT_SHADES_REMAINS_LIST && value:<RAX_REMAINS_MINIMUM_VALUE) {
    hidden = true;
}

apply (name:FACT_ENSOULED_HEAD_LIST && value:<RAX_REMAINS_MINIMUM_VALUE) {
    hidden = true;
}

