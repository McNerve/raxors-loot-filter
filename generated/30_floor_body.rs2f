apply (name:"Mud rune" && quantity:>=RAX_MUD_RUNE_MIN_QUANTITY && RAX_RUNES_SHOW_ABOVE_MIN_QUANTITY) {
  hidden = false;
}
apply (name:"Smoke rune" && quantity:>=RAX_SMOKE_RUNE_MIN_QUANTITY && RAX_RUNES_SHOW_ABOVE_MIN_QUANTITY) {
  hidden = false;
}
apply (name:"Steam rune" && quantity:>=RAX_STEAM_RUNE_MIN_QUANTITY && RAX_RUNES_SHOW_ABOVE_MIN_QUANTITY) {
  hidden = false;
}
apply (name:"Lava rune" && quantity:>=RAX_LAVA_RUNE_MIN_QUANTITY && RAX_RUNES_SHOW_ABOVE_MIN_QUANTITY) {
  hidden = false;
}
apply (name:"Aether rune" && quantity:<RAX_LAVA_RUNE_MIN_QUANTITY && RAX_RUNES_SHOW_ABOVE_MIN_QUANTITY) {
  hidden = false;
}


