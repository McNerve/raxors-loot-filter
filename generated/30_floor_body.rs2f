label: Metal equipment to force hidden
group: Metal Equipment
enum: [
  "Bronze*",
  "Iron*",
  "Steel*",
  "Black*",
  "Mithril*",
  "Adamant*",
  "Rune*",
  "Dragon*"
]
*/
#define RAX_METAL_EQUIPMENT_TIERS_HIDE ["Bronze*","Iron*","Steel*","Black*","Mithril*","Adamant*"]

apply ((name:FACT_BRONZE_ONE_HANDED_MELEE_WEAPONS || name:FACT_BRONZE_TWO_HANDED_MELEE_WEAPONS || name:FACT_BRONZE_RANGED_WEAPONS || name:FACT_BRONZE_AMMO || name:FACT_BRONZE_ARMOUR || name:FACT_BRONZE_OTHER) && name:RAX_METAL_EQUIPMENT_TIERS_HIDE && !name:FACT_DEFENDERS_LIST) {
    hidden = true;
}
