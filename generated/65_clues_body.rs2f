// authored clue families — scroll/box/nest/bottle/geode/casket.

/*@ define:input:clues
type: style
label: Beginner
group: Trail
exampleItem: Clue scroll (beginner)
exampleItemId: 23182
*/
#define RAX_CLUE_BEGINNER_STYLE textColor = "#FFFFFFFF"; backgroundColor = "#80908062"; borderColor = "#FFCFC8C8"; textAccentColor = "#FF000000"; menuTextColor = "#FFCFC8C8"; sound = "clues.wav"; icon = CurrentItem();

#define FACT_CLUE_BEGINNER ["Clue scroll (beginner)", "Scroll box (beginner)", "Clue nest (beginner)", "Clue bottle (beginner)", "Clue geode (beginner)", "Reward casket (beginner)"]

apply (RAX_CLUE_ENABLE && name:FACT_CLUE_BEGINNER) {
    hidden = false;
    RAX_CLUE_BEGINNER_STYLE
}

