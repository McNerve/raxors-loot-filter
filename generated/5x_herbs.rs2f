/*@ define:module:herbs
---
name: Herbs
subtitle: Grimy, clean, secondaries
description: |
  How this kind looks. Value (below) overwrites once the drop is worth real gp.
*/

/*@ define:group
---
name: Herblore
icon:
  type: itemId
  itemId: 207
expanded: false
*/
/*@ define:group
---
name: Herbs
icon:
  type: itemId
  itemId: 207
expanded: false
*/
/*@ define:input:herbs
type: style
label: All Herblore Items Style
group: Herblore
exampleItem: Grimy ranarr weed
exampleItemId: 207
*/
#define RAX_CATEGORY_HERBLORE_CUSTOMSTYLE icon = Sprite(3196, 0);

apply (name:FACT_ALL_HERBS || name:FACT_SECONDARIES_LIST || name:FACT_ALL_HERBLORE_EQUIPMENT) {
  RAX_CATEGORY_HERBLORE_CUSTOMSTYLE
}
/*@ define:input:herbs
type: style
label: Herbs Style
group: Herblore
exampleItem: Guam leaf
exampleItemId: 249
*/
#define RAX_CATEGORY_HERBS_CUSTOMSTYLE

apply (name:FACT_ALL_HERBS) {
  RAX_CATEGORY_HERBS_CUSTOMSTYLE
}
/*@ define:input:herbs
type: style
label: Secondaries Style
group: Herblore
exampleItem: Eye of newt
exampleItemId: 221
*/
#define RAX_CATEGORY_HERBLORE_SECONDARIES_CUSTOMSTYLE

apply (name:FACT_SECONDARIES_LIST) {
  RAX_CATEGORY_HERBLORE_SECONDARIES_CUSTOMSTYLE
}
/*@ define:input:herbs
type: style
label: "Herblore Equipment Style (pestle and mortar, vials, etc.)"
group: Herblore
exampleItem: Pestle and mortar
exampleItemId: 233
*/
#define RAX_CATEGORY_HERBLORE_EQUIPMENT_CUSTOMSTYLE

apply (name:FACT_ALL_HERBLORE_EQUIPMENT) {
  RAX_CATEGORY_HERBLORE_EQUIPMENT_CUSTOMSTYLE
}
/*@ define:input:herbs
type: style
label: Guam leaf custom style
group: Herbs
exampleItem: Guam leaf
*/
#define RAX_HERBS_GUAM_LEAF_CUSTOMSTYLE textColor = "#FFFFFFFF";backgroundColor = "#5009550d";borderColor = "#FF09550d";textAccentColor = "#FF000000";menuTextColor = "#FF09550d";

apply (name:"*guam leaf") {
    RAX_HERBS_GUAM_LEAF_CUSTOMSTYLE 
}
