/*@ define:module:ammo
---
name: Ammo
subtitle: What you shoot
description: |
  How this kind looks. Value (below) overwrites once the drop is worth real gp.
*/

/*@ define:group
---
name: Ammo
icon:
  type: itemId
  itemId: 11212
expanded: false
*/
/*@ define:group
---
name: Fletching
icon:
  type: itemId
  itemId: 52
expanded: false
*/
/*@ define:input:ammo
type: style
label: All Ammo Items Style
group: Ammo
exampleItem: Dragon arrow
exampleItemId: 11212
*/
#define RAX_CATEGORY_AMMO_CUSTOMSTYLE icon = Sprite(3190, 0);

apply (name:FACT_BRONZE_AMMO || name:FACT_IRON_AMMO || name:FACT_STEEL_AMMO || name:FACT_BLACK_AMMO || name:FACT_MITHRIL_AMMO || name:FACT_ADAMANT_AMMO || name:FACT_RUNE_AMMO || name:FACT_DRAGON_AMMO || name:FACT_LAST_MAN_STANDING_AMMO_LIST || name:FACT_AMMO_STANDARD_ARROWS_LIST || name:FACT_AMMO_DARTS_LIST || name:FACT_AMMO_BOLTS_LIST || name:FACT_AMMO_BOLTS_E_LIST || name:FACT_AMMO_DRAGON_BOLTS_E_LIST || name:FACT_AMMO_JAVELINS_LIST || name:FACT_AMMO_SPECIAL_BOLTS_LIST || name:FACT_AMMO_BRUTAL_ARROWS_LIST || name:FACT_AMMO_SPECIAL_ARROWS_LIST || name:FACT_AMMO_KNIVES_LIST || name:FACT_AMMO_THROWING_AXES_LIST || name:FACT_AMMO_CHINCHOMPAS_LIST || name:FACT_AMMO_MISC_LIST) {
    RAX_CATEGORY_AMMO_CUSTOMSTYLE
}
