type: style
label: Arrows Style
group: Ammo
exampleItem: Bronze arrow
exampleItemId: 882
*/
#define RAX_AMMO_ARROWS_CUSTOMSTYLE

apply (name:FACT_AMMO_STANDARD_ARROWS_LIST || name:FACT_AMMO_BRUTAL_ARROWS_LIST || name:FACT_AMMO_SPECIAL_ARROWS_LIST) {
