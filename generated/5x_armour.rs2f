/*@ define:input:armour
type: style
label: Bronze Armour and Weapons
group: Metal Equipment
exampleItem: Bronze platelegs
exampleItemId: 1075
*/
#define RAX_BRONZE_CUSTOMSTYLE textColor = "#FFFFFFFF";backgroundColor = "#8043341d";borderColor = "#FF43341d";textAccentColor = "#FF000000";menuTextColor = "#FF6a5432";

apply (name:FACT_BRONZE_ONE_HANDED_MELEE_WEAPONS || name:FACT_BRONZE_TWO_HANDED_MELEE_WEAPONS || name:FACT_BRONZE_RANGED_WEAPONS || name:FACT_BRONZE_AMMO || name:FACT_BRONZE_ARMOUR || name:FACT_BRONZE_OTHER) {
    RAX_BRONZE_CUSTOMSTYLE 
}
