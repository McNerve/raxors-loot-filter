/*@ define:module:potions
---
name: Potions
subtitle: What you drink
description: |
  How this kind looks. Value (below) overwrites once the drop is worth real gp.
*/

/*@ define:group
---
name: Potions
icon:
  type: itemId
  itemId: 6685
expanded: false
*/
/*@ define:input:potions
type: style
label: All Potion Items Style
group: Potions
exampleItem: Divine super combat potion(4)
exampleItemId: 23685
*/
#define RAX_CATEGORY_ALL_POTIONS_CUSTOMSTYLE icon = Sprite(3231, 0);

apply (name:FACT_POTIONS_LIST || name:FACT_BARB_POTIONS_LIST) {
  RAX_CATEGORY_ALL_POTIONS_CUSTOMSTYLE
}
/*@ define:input:potions
type: style
label: Potions Style
group: Potions
exampleItem: Attack potion(3)
exampleItemId: 121
*/
#define RAX_CATEGORY_POTIONS_CUSTOMSTYLE

apply (name:FACT_POTIONS_LIST) {
  RAX_CATEGORY_POTIONS_CUSTOMSTYLE
}
/*@ define:input:potions
type: style
label: Barbarian Potions Style
group: Potions
exampleItem: Attack mix(2)
exampleItemId: 11429
*/
#define RAX_CATEGORY_BARB_POTIONS_CUSTOMSTYLE

apply (name:FACT_BARB_POTIONS_LIST) {
  RAX_CATEGORY_BARB_POTIONS_CUSTOMSTYLE
}
