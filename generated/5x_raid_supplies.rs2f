/*@ define:input:raid_supplies
type: style
label: Overload custom style
group: Chambers of Xeric
exampleItem: Overload
exampleItemId: 20996
backgroundImage: Chambers of Xeric
*/
#define RAX_COX_OVERLOAD_CUSTOMSTYLE textColor = "#FFFFFFFF";backgroundColor = "#50130F0F";borderColor = "#FF130F0F";textAccentColor = "#FF000000";menuTextColor = "#FF130F0F";icon = CurrentItem();

apply (area:FACT_COX_AREA && name:["overload (-)*",   "overload (4)",   "overload (3)",   "overload (2)",   "overload (1)",   "overload (+)*", ]) {
    RAX_COX_OVERLOAD_CUSTOMSTYLE 
}
