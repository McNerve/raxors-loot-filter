/*@ define:input:raid_supplies
type: style
label: Crystal sceptre custom style
group: Gauntlet
exampleItem: Crystal sceptre
*/
#define RAX_GAUNTLET_CRYSTAL_SCEPTRE_CUSTOMSTYLE textColor = "#FFFFFFFF";backgroundColor = "#5087735b";borderColor = "#FF657e7f";textAccentColor = "#FF000000";

apply (area:FACT_GAUNTLET_AREA && name:"* sceptre") {
    RAX_GAUNTLET_CRYSTAL_SCEPTRE_CUSTOMSTYLE 
}
