// authored rooms — after Joe so these hide/show lists win.

/*@ define:group
---
name: Theatre of Blood
icon:
  type: itemId
  itemId: 22326
expanded: false
*/

/*@ define:input:locations
type: stringlist
label: Theatre of Blood force shown
group: Theatre of Blood
*/
#define RAX_ROOM_TOB_SHOW ["Scythe of vitur (uncharged)", "Ghrazi rapier", "Sanguinesti staff (uncharged)", "Justiciar faceguard", "Justiciar chestguard", "Justiciar legguards", "Avernic defender hilt", "Holy ornament kit", "Sanguine ornament kit", "Sanguine dust"]

/*@ define:input:locations
type: stringlist
label: Theatre of Blood force hidden
group: Theatre of Blood
*/
#define RAX_ROOM_TOB_HIDE []

apply ((area:FACT_TOB_AREA) && name:RAX_ROOM_TOB_HIDE) {
    hidden = true;
}

apply ((area:FACT_TOB_AREA) && name:RAX_ROOM_TOB_SHOW) {
    hidden = false;
}

