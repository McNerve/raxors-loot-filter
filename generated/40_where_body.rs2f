]
*/
#define RAX_COX_BATS_HIDE ["Guanic bat (0)","Prael bat (1)","Giral bat (2)","Phluxia bat (3)","Kryket bat (4)","Murng bat (5)","Psykk bat (6)"]

/*@ define:input:where
