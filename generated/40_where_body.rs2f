/*@ define:input:where
type: number
label: Hide items below this value
group: Bounty Hunter
*/
#define RAX_BOUNTY_HUNTER_MINIMUM_VALUE 0

apply (area:FACT_BOUNTY_HUNTER_AREA && (tradeable:true || name:FACT_GLOBAL_TRADEABLE_NON_TRADEABLE_ITEMS) && value:<RAX_BOUNTY_HUNTER_MINIMUM_VALUE) {
    hidden = true;
}

/*@ define:input:where
type: number
label: Hide stackable items below this value
group: Bounty Hunter
*/
#define RAX_BOUNTY_HUNTER_STACKABLE_MINIMUM_VALUE 0

apply (area:FACT_BOUNTY_HUNTER_AREA && (tradeable:true || name:FACT_GLOBAL_TRADEABLE_NON_TRADEABLE_ITEMS) && (stackable:true || noted:true) && value:<RAX_BOUNTY_HUNTER_STACKABLE_MINIMUM_VALUE) {
    hidden = true;
}

/*@ define:input:where
type: number
label: Hide non-stackable items below this value
group: Bounty Hunter
*/
#define RAX_BOUNTY_HUNTER_NON_STACKABLE_MINIMUM_VALUE 0

apply (area:FACT_BOUNTY_HUNTER_AREA && (tradeable:true || name:FACT_GLOBAL_TRADEABLE_NON_TRADEABLE_ITEMS) && stackable:false && noted:false && value:<RAX_BOUNTY_HUNTER_NON_STACKABLE_MINIMUM_VALUE) {
    hidden = true;
}

