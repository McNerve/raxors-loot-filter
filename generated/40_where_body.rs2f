label: Seeds to force hidden
group: Chambers of Xeric
enum: [
  "Golpar seed",
  "Buchu seed",
  "Noxifer seed"
]
*/
#define RAX_COX_SEEDS_HIDE []

/*@ define:input:where
type: enumlist
label: Misc drops to force hidden
group: Chambers of Xeric
enum: [
  "Bones",
  "Big bones",
  "Lockpick",
  "Fishing rod",
  "Iron pickaxe",
  "Iron axe",
  "Butterfly net",
  "Hammer",
  "Tinderbox",
  "Cave worms",
  "Endarkened juice",
  "Stinkhorn mushroom",
  "Cicely",
  "Mallignum root plank",
  "Cavern grubs",
  "Empty gourd vial",
  "Water-filled gourd vial",
  "Spade",
  "Seed dipper",
  "Rake"
]
*/
#define RAX_COX_MISC_DROPS_HIDE ["Bones","Big bones","Fishing rod","Iron pickaxe","Iron axe","Butterfly net","Hammer","Tinderbox","Cave worms"]

apply (area:FACT_COX_AREA && name:RAX_COX_FISH_HIDE) {
    hidden = true;
}
apply (area:FACT_COX_AREA && name:RAX_COX_BATS_HIDE) {
    hidden = true;
}
apply (area:FACT_COX_AREA && name:RAX_COX_SEEDS_HIDE) {
    hidden = true;
}
apply (area:FACT_COX_AREA && name:RAX_COX_MISC_DROPS_HIDE) {
    hidden = true;
}
apply (area:FACT_COX_AREA && name:["elder (-)*",   "elder potion*",   "elder (+)*", ] && name:RAX_COX_POTIONS_HIDE) {
    hidden = true;
}
apply (area:FACT_COX_AREA && name:["twisted (-)*",   "twisted potion*",   "twisted (+)*", ] && name:RAX_COX_POTIONS_HIDE) {
    hidden = true;
}
apply (area:FACT_COX_AREA && name:["kodai (-)*",   "kodai potion*",   "kodai (+)*", ] && name:RAX_COX_POTIONS_HIDE) {
    hidden = true;
}
apply (area:FACT_COX_AREA && name:["revitalisation (-)*",   "revitalisation potion*",   "revitalisation (+)*", ] && name:RAX_COX_POTIONS_HIDE) {
    hidden = true;
}
apply (area:FACT_COX_AREA && name:["prayer enhance (-)*",   "prayer enhance (4)",   "prayer enhance (3)",   "prayer enhance (2)",   "prayer enhance (1)",   "prayer enhance (+)*", ] && name:RAX_COX_POTIONS_HIDE) {
    hidden = true;
}
apply (area:FACT_COX_AREA && name:["xeric's aid (-)*",   "xeric's aid (4)",   "xeric's aid (3)",   "xeric's aid (2)",   "xeric's aid (1)",   "xeric's aid (+)*", ] && name:RAX_COX_POTIONS_HIDE) {
    hidden = true;
}
apply (area:FACT_COX_AREA && name:["antipoison (-)*",   "antipoison (4)",   "antipoison (3)",   "antipoison (2)",   "antipoison (1)",   "antipoison (+)*", ] && name:RAX_COX_POTIONS_HIDE) {
    hidden = true;
}
apply (area:FACT_COX_AREA && name:["overload (-)*",   "overload (4)",   "overload (3)",   "overload (2)",   "overload (1)",   "overload (+)*", ] && name:RAX_COX_POTIONS_HIDE) {
    hidden = true;
}


