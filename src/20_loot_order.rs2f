/*@ define:module:loot_order
---
name: Loot order
subtitle: Take-menu order
description: |
  What you pick up first. Turn OFF "Price Sort" in Custom Menu Swaps → Ground Item Sort.

  The ladder itself is generated in the hidden final pass.
*/

/*@ define:input:loot_order
type: boolean
label: Sort by GE value
*/
#define RAX_SORT_BY_VALUE true

/*@ define:input:loot_order
type: boolean
label: Stackable / noted first
*/
#define RAX_SORT_STACKABLES_FIRST true

/*@ define:input:loot_order
type: boolean
label: Untradeables first
*/
#define RAX_SORT_UNTRADEABLE_FIRST true

/*@ define:input:loot_order
type: stringlist
label: Always take these first
*/
#define RAX_SORT_PIN ["xeric's aid*","Revitalisation*","Prayer enhance*","twisted*"]
