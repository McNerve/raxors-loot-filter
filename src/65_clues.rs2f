/*@ define:module:clues
---
name: Clues
subtitle: The whole trail, one tier
description: |
  Scroll, box, nest, bottle, geode, casket, challenge — same style.
  Items are facts. You pick the look and which tiers to mute.

  After Value so a clue never turns into a gp chip. Alerts can still ping.
*/

/*@ define:group
---
name: Trail
expanded: false
*/

/*@ define:input:clues
type: boolean
label: Style clues
group: Trail
*/
#define RAX_CLUE_ENABLE true

/*@ define:input:clues
type: boolean
label: Hide beginner
group: Trail
*/
#define RAX_CLUE_MUTE_BEGINNER false

/*@ define:input:clues
type: boolean
label: Hide easy
group: Trail
*/
#define RAX_CLUE_MUTE_EASY false

/*@ define:input:clues
type: boolean
label: Hide medium
group: Trail
*/
#define RAX_CLUE_MUTE_MEDIUM false

/*@ define:input:clues
type: boolean
label: Hide hard
group: Trail
*/
#define RAX_CLUE_MUTE_HARD false

/*@ define:input:clues
type: boolean
label: Hide elite
group: Trail
*/
#define RAX_CLUE_MUTE_ELITE false

/*@ define:input:clues
type: boolean
label: Hide master
group: Trail
*/
#define RAX_CLUE_MUTE_MASTER false

/*{{RAX_CLUES_BODY}}*/

/*@ define:group
---
name: Wilderness step
expanded: false
description: |
  Hard/elite clues that rolled a wilderness step. Overlay after the tier style.
*/

/*@ define:input:clues
type: style
label: Hard wilderness
group: Wilderness step
exampleItem: Clue scroll (hard)
exampleItemId: 2722
*/
#define RAX_CLUE_HARD_WILDY_STYLE textColor = "#FFFFFFFF"; backgroundColor = "#80908062"; borderColor = "#FF000000"; textAccentColor = "#FF000000"; menuTextColor = "#FF000000"; sound = "clues.wav"; icon = CurrentItem();

apply (RAX_CLUE_ENABLE && id:FACT_CLUE_HARD_WILDY_IDS) {
    RAX_CLUE_HARD_WILDY_STYLE
}

/*@ define:input:clues
type: style
label: Elite wilderness
group: Wilderness step
exampleItem: Clue scroll (elite)
exampleItemId: 12073
*/
#define RAX_CLUE_ELITE_WILDY_STYLE textColor = "#FFFFFFFF"; backgroundColor = "#80908062"; borderColor = "#FF000000"; textAccentColor = "#FF000000"; menuTextColor = "#FF000000"; sound = "clues.wav"; icon = CurrentItem();

apply (RAX_CLUE_ENABLE && id:FACT_CLUE_ELITE_WILDY_IDS) {
    RAX_CLUE_ELITE_WILDY_STYLE
}

apply (RAX_CLUE_MUTE_BEGINNER && name:FACT_CLUE_BEGINNER) { hidden = true; }
apply (RAX_CLUE_MUTE_EASY && name:FACT_CLUE_EASY) { hidden = true; }
apply (RAX_CLUE_MUTE_MEDIUM && name:FACT_CLUE_MEDIUM) { hidden = true; }
apply (RAX_CLUE_MUTE_HARD && name:FACT_CLUE_HARD) { hidden = true; }
apply (RAX_CLUE_MUTE_ELITE && name:FACT_CLUE_ELITE) { hidden = true; }
apply (RAX_CLUE_MUTE_MASTER && name:FACT_CLUE_MASTER) { hidden = true; }
