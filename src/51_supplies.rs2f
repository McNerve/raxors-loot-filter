// Authored category extras. After Joe categories so these styles win.

/*@ define:input:categories
type: style
label: Seeking arrows
group: Ammo
exampleItem: Seeking dragon arrow
exampleItemId: 11212
*/
#define RAX_AMMO_SEEKING_STYLE

apply (name:FACT_AMMO_SEEKING_ARROWS_LIST) {
    RAX_CATEGORY_AMMO_CUSTOMSTYLE
    RAX_AMMO_ARROWS_CUSTOMSTYLE
    RAX_AMMO_SEEKING_STYLE
}

/*@ define:input:categories
type: style
label: Bloodwood sap / seeking shafts
group: Fletching
exampleItem: Arrow shaft
exampleItemId: 52
*/
#define RAX_BLOODWOOD_STYLE

apply (name:FACT_BLOODWOOD_LIST) {
    RAX_BLOODWOOD_STYLE
}

