/*@ define:module:kits
---
name: Kits
subtitle: Reminders and silence
description: |
  Backpack ping when a single piece of ammo hits the floor. Mute deathpiles and LMS.
*/

/*@ define:input:kits
type: boolean
label: Backpack reminder
group: Backpack
*/
#define RAX_AMMO_PING true

/*@ define:input:kits
type: number
label: Backpack sound ID
group: Backpack
*/
#define RAX_AMMO_PING_SOUND 933

apply ((name:FACT_AMMO_STANDARD_ARROWS_LIST || name:FACT_AMMO_BRUTAL_ARROWS_LIST || name:FACT_AMMO_SPECIAL_ARROWS_LIST || name:FACT_AMMO_DARTS_LIST || name:FACT_AMMO_JAVELINS_LIST || name:FACT_AMMO_BOLTS_LIST || name:FACT_AMMO_BOLTS_E_LIST || name:FACT_AMMO_DRAGON_BOLTS_E_LIST || name:FACT_AMMO_SPECIAL_BOLTS_LIST) && ownership:OWNERSHIP_SELF && quantity:==1 && RAX_AMMO_PING) {
    sound = RAX_AMMO_PING_SOUND;
}

/*@ define:input:kits
type: boolean
label: Mute UIM deathpile spots
group: Silence
*/
#define RAX_MUTE_DEATHPILE true

apply (accountType:FACT_ACCOUNT_TYPE_ULTIMATE_IRONMAN && RAX_MUTE_DEATHPILE && (area:FACT_PRIF_SPAWN_AREA || area:FACT_FALADOR_SPAWN_AREA || area:FACT_EDGEVILLE_NETTLES_AREA || area:FACT_EDGEVILLE_MONASTERY_SECOND_FLOOR_AREA || area:FACT_ARDY_MARKET_CHEST_AREA || area:FACT_COLO_LOBBY_AREA || area:FACT_LUMBRIDGE_BASEMENT_CAVE_EXIT_AREA)) {
    sound = 2411;
    notify = false;
}

/*@ define:input:kits
type: boolean
label: Mute Last Man Standing
group: Silence
*/
#define RAX_MUTE_LMS true

apply (RAX_MUTE_LMS && (area:FACT_LAST_MAN_STANDING_DESERT_ISLAND_AREA || area:FACT_LAST_MAN_STANDING_WILD_VARROCK_AREA)) {
    sound = 2411;
    notify = false;
}

/*@ define:input:kits
type: boolean
label: Mute other players' drops
group: Silence
*/
#define RAX_MUTE_OTHERS false

apply (RAX_MUTE_OTHERS && ownership:OWNERSHIP_OTHER) {
    sound = 2411;
    notify = false;
}

/*@ define:input:kits
type: boolean
label: Mute world spawns
group: Silence
*/
#define RAX_MUTE_SPAWNS false

apply (RAX_MUTE_SPAWNS && ownership:OWNERSHIP_NONE) {
    sound = 2411;
    notify = false;
}
