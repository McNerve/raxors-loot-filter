label: Inferno
group: Inferno
exampleItem: Twisted bow
exampleItemId: 20997
*/
#define RAX_HEAT_4_STYLE textColor = "#ff000000"; backgroundColor = "#99c30000"; borderColor = "#ff000000"; textAccentColor = "#47000000"; lootbeamColor = "#ff000000"; menuTextColor = "#99c30000"; textAccent = 1; fontType = 1; showLootbeam = true; sound = "tier4.wav"; menuSort = 0; icon = CurrentItem();

apply (value:>=RAX_HEAT_4_VALUE || name:RAX_HEAT_4_PIN) {
    RAX_HEAT_4_STYLE
}

/*@ define:group
---
name: Locks
expanded: false
description: |
  Stop later modules from restyling a heat band. Off by default — Always (uniques / alchs) should still win.
*/

/*@ define:input:heat
type: boolean
label: Lock Ember
group: Locks
*/
#define RAX_HEAT_1_LOCK false

/*@ define:input:heat
type: boolean
label: Lock Glow
group: Locks
*/
#define RAX_HEAT_2_LOCK false

/*@ define:input:heat
type: boolean
label: Lock Blaze
group: Locks
*/
#define RAX_HEAT_3_LOCK false

/*@ define:input:heat
type: boolean
label: Lock Inferno
group: Locks
*/
#define RAX_HEAT_4_LOCK false

rule (RAX_HEAT_1_LOCK && ((value:>=RAX_HEAT_1_VALUE && value:<RAX_HEAT_2_VALUE) || name:RAX_HEAT_1_PIN)) {}
rule (RAX_HEAT_2_LOCK && ((value:>=RAX_HEAT_2_VALUE && value:<RAX_HEAT_3_VALUE) || name:RAX_HEAT_2_PIN)) {}
rule (RAX_HEAT_3_LOCK && ((value:>=RAX_HEAT_3_VALUE && value:<RAX_HEAT_4_VALUE) || name:RAX_HEAT_3_PIN)) {}
rule (RAX_HEAT_4_LOCK && (value:>=RAX_HEAT_4_VALUE || name:RAX_HEAT_4_PIN)) {}
