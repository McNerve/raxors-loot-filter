#define RAX_HEAT_2_VALUE 100000

/*@ define:input:heat
type: stringlist
label: Pin to Glow
group: Glow
*/
#define RAX_HEAT_2_PIN ["Dossier","Ice quartz","Frozen tablet","Blood quartz","Strangled tablet","Shadow quartz","Sirenic tablet","Smoke quartz","Scarred tablet","Dark claw","Frozen cache","Ancient icon","Curved bone","Kq head"]

/*@ define:input:heat
type: style
label: Glow
group: Glow
exampleItem: Infinity boots
exampleItemId: 6920
*/
#define RAX_HEAT_2_STYLE textColor = "#ff000000"; backgroundColor = "#9966b2ff"; borderColor = "#ff000000"; textAccentColor = "#47000000"; menuTextColor = "#9966b2ff"; textAccent = 1; fontType = 1; icon = CurrentItem();

apply ((value:>=RAX_HEAT_2_VALUE && value:<RAX_HEAT_3_VALUE) || name:RAX_HEAT_2_PIN) {
    RAX_HEAT_2_STYLE
}

