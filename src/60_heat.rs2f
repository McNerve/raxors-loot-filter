#define RAX_HEAT_3_STYLE textColor = "#ff000000"; backgroundColor = "#99f29b4b"; borderColor = "#ff000000"; textAccentColor = "#87000000"; lootbeamColor = "#f2000000"; menuTextColor = "#99f29b4b"; textAccent = 1; fontType = 1; showLootbeam = true; sound = "tier3.wav"; menuSort = 0; icon = CurrentItem();

