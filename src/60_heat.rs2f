/*@ define:module:heat
---
name: Heat
subtitle: How loud is this drop
description: |
  Ink-on-pill temperature. Runs after aisle, so a 2m shark is amber — not a food chip.

  20k green · 100k blue · 1m amber + beam + sound · 10m crimson + beam + sound
*/

/*@ define:group
---
name: Ember
icon:
  type: itemId
  itemId: 10828
expanded: false
*/

/*@ define:input:heat
type: number
label: Ember starts at
group: Ember
*/
#define RAX_HEAT_1_VALUE 20000

/*@ define:input:heat
type: stringlist
label: Pin to Ember
group: Ember
*/
#define RAX_HEAT_1_PIN ["Vorkath's head","Giantsoul amulet","Desiccated page","Pendant of ates","Long bone","Scurrius' spine","Alchemist's signet","unidentified*"]

/*@ define:input:heat
type: style
label: Ember
group: Ember
exampleItem: Helm of neitiznot
exampleItemId: 10828
*/
#define RAX_HEAT_1_STYLE textColor = "#ff000000"; backgroundColor = "#9945dc32"; borderColor = "#ff000000"; textAccentColor = "#47000000"; menuTextColor = "#9945dc32"; textAccent = 1; icon = CurrentItem();

apply ((value:>=RAX_HEAT_1_VALUE && value:<RAX_HEAT_2_VALUE) || name:RAX_HEAT_1_PIN) {
    RAX_HEAT_1_STYLE
}

