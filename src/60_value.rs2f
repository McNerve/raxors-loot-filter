/*@ define:module:value
---
name: Value
subtitle: GE value tiers
description: |
  Same buckets as the old Ground Items plugin: Low, Medium, High, Insane.

  Runs after Categories, so a 2m shark is High, not a food chip.
  Rares (below) still overwrite this.
*/

/*@ define:group
---
name: Low
icon:
  type: itemId
  itemId: 10828
expanded: false
*/

/*@ define:input:value
type: number
label: Low starts at
group: Low
*/
#define RAX_HEAT_1_VALUE 20000

/*@ define:input:value
type: stringlist
label: Pin to Low
group: Low
*/
#define RAX_HEAT_1_PIN ["Vorkath's head","Giantsoul amulet","Desiccated page","Pendant of ates","Long bone","Scurrius' spine","Alchemist's signet","unidentified*"]

/*@ define:input:value
type: style
label: Low
group: Low
exampleItem: Helm of neitiznot
exampleItemId: 10828
*/
#define RAX_HEAT_1_STYLE textColor = "#ff000000"; backgroundColor = "#9945dc32"; borderColor = "#ff000000"; textAccentColor = "#47000000"; menuTextColor = "#9945dc32"; textAccent = 1; icon = CurrentItem();

apply ((value:>=RAX_HEAT_1_VALUE && value:<RAX_HEAT_2_VALUE) || name:RAX_HEAT_1_PIN) {
    RAX_HEAT_1_STYLE
}

/*@ define:group
---
name: Medium
icon:
  type: itemId
  itemId: 6920
expanded: false
*/

/*@ define:input:value
type: number
label: Medium starts at
group: Medium
*/
#define RAX_HEAT_2_VALUE 100000

/*@ define:input:value
type: stringlist
label: Pin to Medium
group: Medium
*/
#define RAX_HEAT_2_PIN ["Dossier","Ice quartz","Frozen tablet","Blood quartz","Strangled tablet","Shadow quartz","Sirenic tablet","Smoke quartz","Scarred tablet","Dark claw","Frozen cache","Ancient icon","Curved bone","Kq head"]

/*@ define:input:value
type: style
label: Medium
group: Medium
exampleItem: Infinity boots
exampleItemId: 6920
*/
#define RAX_HEAT_2_STYLE textColor = "#ff000000"; backgroundColor = "#9966b2ff"; borderColor = "#ff000000"; textAccentColor = "#47000000"; menuTextColor = "#9966b2ff"; textAccent = 1; fontType = 1; icon = CurrentItem();

apply ((value:>=RAX_HEAT_2_VALUE && value:<RAX_HEAT_3_VALUE) || name:RAX_HEAT_2_PIN) {
    RAX_HEAT_2_STYLE
}

/*@ define:group
---
name: High
icon:
  type: itemId
  itemId: 4151
expanded: false
*/

/*@ define:input:value
type: number
label: High starts at
group: High
*/
#define RAX_HEAT_3_VALUE 1000000

/*@ define:input:value
type: stringlist
label: Pin to High
group: High
*/
#define RAX_HEAT_3_PIN ["Forgotten lockbox","Noxious pommel","Noxious point","Noxious blade","Hydra's eye","Hydra's fang","Hydra's heart","Unsired","Bludgeon claw","Bludgeon spine","Bludgeon axon","Dark totem","Slepey tablet","Parasitic egg","Mystic vigour prayer scroll","Deadeye prayer scroll","Kq head (tattered)"]

/*@ define:input:value
type: style
label: High
group: High
exampleItem: Abyssal whip
exampleItemId: 4151
*/
#define RAX_HEAT_3_STYLE textColor = "#ff000000"; backgroundColor = "#99f29b4b"; borderColor = "#ff000000"; textAccentColor = "#87000000"; lootbeamColor = "#f2000000"; menuTextColor = "#99f29b4b"; textAccent = 1; fontType = 1; showLootbeam = true; sound = "tier3.wav"; menuSort = 0; icon = CurrentItem();

apply ((value:>=RAX_HEAT_3_VALUE && value:<RAX_HEAT_4_VALUE) || name:RAX_HEAT_3_PIN) {
    RAX_HEAT_3_STYLE
}

/*@ define:group
---
name: Insane
icon:
  type: itemId
  itemId: 20997
expanded: false
*/

/*@ define:input:value
type: number
label: Insane starts at
group: Insane
*/
#define RAX_HEAT_4_VALUE 10000000

/*@ define:input:value
type: stringlist
label: Pin to Insane
group: Insane
*/
#define RAX_HEAT_4_PIN ["Venator vestige","Leviathan's lure","Bellator vestige","Siren's staff","Ultor vestige","Executioner's axe head","Magus vestige","Eye of the duke","Araxyte fang","Tanzanite mutagen","Magma mutagen","Earth Warrior champion scroll","Ghoul champion scroll","Giant champion scroll","Goblin champion scroll","Hobgoblin champion scroll","Imp champion scroll","Jogre champion scroll","Lesser Demon champion scroll","Skeleton champion scroll","Zombie champion scroll","Mokhaiotl cloth","Eye of ayak","Avernic treads"]

/*@ define:input:value
type: style
label: Insane
group: Insane
exampleItem: Twisted bow
exampleItemId: 20997
*/
#define RAX_HEAT_4_STYLE textColor = "#ff000000"; backgroundColor = "#99c30000"; borderColor = "#ff000000"; textAccentColor = "#47000000"; lootbeamColor = "#ff000000"; menuTextColor = "#99c30000"; textAccent = 1; fontType = 1; showLootbeam = true; sound = "tier4.wav"; menuSort = 0; icon = CurrentItem();

apply (value:>=RAX_HEAT_4_VALUE || name:RAX_HEAT_4_PIN) {
    RAX_HEAT_4_STYLE
}


apply (!RAX_ALLOW_LOOTBEAMS) {
    showLootbeam = false;
}

apply (!RAX_ALLOW_SOUNDS) {
    sound = 2411;
}

/*@ define:group
---
name: Locks
expanded: false
description: |
  Stop later modules from restyling this tier. Off by default so Rares can still win.
*/

/*@ define:input:value
type: boolean
label: Lock Low
group: Locks
*/
#define RAX_HEAT_1_LOCK false

/*@ define:input:value
type: boolean
label: Lock Medium
group: Locks
*/
#define RAX_HEAT_2_LOCK false

/*@ define:input:value
type: boolean
label: Lock High
group: Locks
*/
#define RAX_HEAT_3_LOCK false

/*@ define:input:value
type: boolean
label: Lock Insane
group: Locks
*/
#define RAX_HEAT_4_LOCK false

rule (RAX_HEAT_1_LOCK && ((value:>=RAX_HEAT_1_VALUE && value:<RAX_HEAT_2_VALUE) || name:RAX_HEAT_1_PIN)) {}
rule (RAX_HEAT_2_LOCK && ((value:>=RAX_HEAT_2_VALUE && value:<RAX_HEAT_3_VALUE) || name:RAX_HEAT_2_PIN)) {}
rule (RAX_HEAT_3_LOCK && ((value:>=RAX_HEAT_3_VALUE && value:<RAX_HEAT_4_VALUE) || name:RAX_HEAT_3_PIN)) {}
rule (RAX_HEAT_4_LOCK && (value:>=RAX_HEAT_4_VALUE || name:RAX_HEAT_4_PIN)) {}
