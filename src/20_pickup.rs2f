/*@ define:module:pickup
---
name: Pickup
subtitle: What you grab first
description: |
  Orders the take-menu. Requires "Price Sort" in Custom Menu Swaps → Ground Item Sort to be OFF.

  The actual ladder lives in the hidden final pass — this module is just the switches.
*/

/*@ define:input:pickup
type: boolean
label: Sort by value
*/
#define RAX_SORT_BY_VALUE true

/*@ define:input:pickup
type: boolean
label: Stackable / noted first
*/
#define RAX_SORT_STACKABLES_FIRST true

/*@ define:input:pickup
type: boolean
label: Untradeables first
*/
#define RAX_SORT_UNTRADEABLE_FIRST true

/*@ define:input:pickup
type: stringlist
label: Always pick these first
*/
#define RAX_SORT_PIN ["xeric's aid*","Revitalisation*","Prayer enhance*","twisted*"]
