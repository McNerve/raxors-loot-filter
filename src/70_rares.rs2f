/*@ define:module:rares
---
name: Rares
subtitle: Collection log, alchs, RDT
description: |
  One Filterscape group per collection log page. Only slots that can hit
  the floor. Rare slots scream. Log slots (knives, pages, tears) just show.

  Chest pages (raids, Colosseum, Gauntlet, Barrows, inferno) are omitted —
  those items never land on the ground.

  Runs after Value. Alchs lock gold by default.
*/

/*@ define:group
---
name: Collection log
expanded: false
description: |
  Master style for every page below. Turn a page off if you are camping it.
*/

/*@ define:input:rares
type: boolean
label: Style rare slots
group: Collection log
*/
#define RAX_UNIQUE_ENABLE true

/*@ define:input:rares
type: style
label: Rare
group: Collection log
exampleItem: Tanzanite fang
exampleItemId: 12922
*/
#define RAX_UNIQUE_STYLE lootbeamColor = "#ff000000"; menuTextColor = "#ffff0084"; fontType = 3; showLootbeam = true; sound = "uniques.wav"; icon = CurrentItem();

/*@ define:input:rares
type: boolean
label: Style log slots
group: Collection log
*/
#define RAX_NOTABLE_ENABLE true

/*@ define:input:rares
type: style
label: Log
group: Collection log
exampleItem: Dragon knife
exampleItemId: 22804
*/
#define RAX_NOTABLE_STYLE menuTextColor = "#ffff0084"; fontType = 1; icon = CurrentItem();

/*@ define:input:rares
type: boolean
label: Silence rare sounds at bosses that already roar
group: Collection log
*/
#define RAX_UNIQUE_SILENCE_BOSS_SOUND false

/*@ define:input:rares
type: boolean
label: Lock rare slots
group: Collection log
*/
#define RAX_UNIQUE_LOCK false

/*{{RAX_UNIQUES_BODY}}*/

apply (RAX_UNIQUE_SILENCE_BOSS_SOUND && name:RAX_UNIQUES_LIST && (
    area:FACT_MUSPAH_AREA || area:FACT_THE_WHISPERER_AREA || area:FACT_VARDORVIS_AREA ||
    area:FACT_DUKE_SUCELLUS_AREA || area:FACT_THE_LEVIATHAN_AREA || area:FACT_YAMA_AREA ||
    area:FACT_NEX_AREA || area:FACT_AMOXLIATL_AREA || area:FACT_HUEYCOATL_AREA ||
    area:FACT_MAGGOT_KING_AREA || area:FACT_DOOM_MOKHAIOTL_AREA || area:FACT_ROYAL_TITANS_AREA ||
    area:FACT_SLAYER_ARAXYTES_AREA || area:FACT_SLAYER_HYDRAS_AREA || area:FACT_COLOSSEUM_AREA
)) {
    sound = 2411;
}

rule (RAX_UNIQUE_LOCK && name:RAX_UNIQUES_LIST) {}

/*@ define:group
---
name: Alchs
icon:
  type: itemId
  itemId: 1079
expanded: false
*/

/*@ define:input:rares
type: boolean
label: Force-show alchs
group: Alchs
*/
#define RAX_ALCH_FORCE_SHOW true

apply (RAX_ALCH_FORCE_SHOW && name:RAX_ALCHS_LIST) {
    hidden = false;
}

/*@ define:input:rares
type: style
label: Alchs
group: Alchs
exampleItem: Rune platelegs
exampleItemId: 1079
*/
#define RAX_ALCH_STYLE textColor = "#ff000000"; backgroundColor = "#a1fadb3e"; borderColor = "#ff000000"; textAccentColor = "#47000000"; menuTextColor = "#a1fadb3e"; textAccent = 1; fontType = 1; showValue = true; showDespawn = true; icon = File("alch.png");

apply (name:RAX_ALCHS_LIST) {
    RAX_ALCH_STYLE
}

/*@ define:input:rares
type: stringlist
label: Alch list
group: Alchs
*/
#define RAX_ALCHS_LIST /*{{RAX_ALCHS_LIST}}*/

/*@ define:input:rares
type: boolean
label: Lock alchs
group: Alchs
*/
#define RAX_ALCH_LOCK true

rule (RAX_ALCH_LOCK && name:RAX_ALCHS_LIST) {}

/*@ define:group
---
name: Rare drop table
icon:
  type: itemId
  itemId: 1249
expanded: false
*/

/*@ define:input:rares
type: style
label: Rare drop table
group: Rare drop table
exampleItem: Dragon spear
exampleItemId: 1249
*/
#define RAX_RDT_STYLE borderColor = "#FFdea71a"; textAccentColor = "#47000000"; menuTextColor = "#FFdea71a"; icon = CurrentItem();

// RDT quantity matches are injected by tools/build.py
